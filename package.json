{
  "name": "agent-control",
  "version": "0.2.4",
  "description": "Self-hosted remote control console for local Codex, Claude Code, and Antigravity sessions.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "service": "node scripts/service.mjs",
    "relay": "node relay/relay-server.mjs",
    "invite": "node scripts/create-invite.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node scripts/check-syntax.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "desktop:build": "bash desktop/macos/build-app.sh",
    "desktop:install": "bash desktop/macos/build-app.sh --install"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  }
}
